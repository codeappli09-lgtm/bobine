# --- IA qui écrit le script -------------------------------------------------
# Option 1 (par défaut, gratuit) : Qwen tourne dans ton Codespace via Ollama.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b
# Plus rapide mais un peu moins bon : LLM_MODEL=qwen3.5:2b

# Option 2 : une API compatible OpenAI (ex. OpenRouter, avec un modèle Qwen gratuit).
# Décommente ces lignes et mets ta clé :
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=ta-cle-ici
# LLM_MODEL=nom-du-modele-qwen-sur-openrouter

# --- Vidéos de fond (facultatif) ---------------------------------------------
# Clé gratuite sur https://www.pexels.com/api/ : de vraies vidéos par plan.
PEXELS_API_KEY=

# --- Redécoupage de tes vidéos -----------------------------------------------
# Modèle de transcription : base (rapide) < small (conseillé) < medium (précis, lent)
WHISPER_MODEL=small
WHISPER_LANG=fr

# --- Montage -----------------------------------------------------------------
# ultrafast = plus rapide, fichier plus lourd ; medium = plus lent, plus net
X264_PRESET=veryfast
